<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.username %> - Xóm Nhỏ</title>
  <meta name="description" content="Trang bio-link của <%= profile.username %> trên Xóm Nhỏ">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      min-height: 100vh;
      padding: 20px;
      color: #fff;
    }
    .container { max-width: 600px; margin: 0 auto; padding-top: 40px; }
    .header { text-align: center; margin-bottom: 32px; }
    .avatar {
      width: 96px; height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex; align-items: center; justify-content: center;
      font-size: 36px; font-weight: bold;
      margin: 0 auto 16px;
      border: 3px solid rgba(255,255,255,0.1);
    }
    .username { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
    .bio { font-size: 14px; color: #9ca3af; }
    .links { display: flex; flex-direction: column; gap: 12px; }
    .link-btn {
      display: flex; align-items: center;
      padding: 16px 20px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      text-decoration: none;
      color: #fff;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .link-btn:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-2px);
      border-color: rgba(255,255,255,0.2);
    }
    .link-btn:active { transform: translateY(0); }
    .link-title { flex: 1; }
    .empty {
      text-align: center;
      padding: 40px 20px;
      color: #6b7280;
      font-size: 14px;
    }
    .footer {
      text-align: center;
      margin-top: 40px;
      padding: 20px;
      font-size: 12px;
      color: #6b7280;
    }
    .footer a { color: #9ca3af; text-decoration: none; }
    .footer a:hover { color: #fff; }
  </style>
</head>
<body>
  <div class="container">
<div class="header">
  <div class="avatar">
    <% if (profile.avatar_url) { %>
      <img src="<%= profile.avatar_url %>" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
    <% } else { %>
      <%= profile.username.charAt(0).toUpperCase() %>
    <% } %>
  </div>
  <h1 class="username"><%= profile.display_name || '@' + profile.username %></h1>
  <p class="bio"><%= profile.bio || 'Thành viên Xóm Nhỏ' %></p>
</div>
    <div class="links">
      <% if (profile.links && profile.links.length > 0) { %>
        <% profile.links.forEach(function(link) { %>
          <a href="<%= link.url %>" target="_blank" rel="noopener" class="link-btn" data-link-id="<%= link.id %>">
            <span class="link-title"><%= link.title %></span>
          </a>
        <% }); %>
      <% } else { %>
        <div class="empty">Chưa có link nào</div>
      <% } %>
    </div>

    <div class="footer">
      Made with <a href="/">Xóm Nhỏ</a>
    </div>
  </div>

  <script>
    document.querySelectorAll('.link-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const linkId = this.dataset.linkId;
        fetch('/api/profile/click/' + linkId, { method: 'POST' }).catch(function(){});
      });
    });
  </script>
</body>
</html>
