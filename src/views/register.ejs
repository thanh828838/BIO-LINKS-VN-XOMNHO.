<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng ký - Xóm Nhỏ</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, sans-serif; background: #1a1a2e; color: #fff; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .container { max-width: 400px; width: 100%; }
    h1 { text-align: center; margin-bottom: 24px; font-size: 28px; }
    input { width: 100%; padding: 12px 16px; margin-bottom: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; font-size: 15px; }
    input:focus { outline: none; border-color: #667eea; }
    button { width: 100%; padding: 14px; background: #667eea; color: #fff; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; }
    button:hover { background: #5568d3; }
    .message { margin-top: 12px; padding: 10px; border-radius: 6px; font-size: 14px; text-align: center; }
    .error { background: rgba(239,68,68,0.2); color: #fca5a5; }
    .success { background: rgba(34,197,94,0.2); color: #86efac; }
    .link { text-align: center; margin-top: 16px; font-size: 14px; }
    .link a { color: #9ca3af; text-decoration: none; }
    .link a:hover { color: #fff; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Đăng ký</h1>
    <form id="registerForm">
      <input type="text" id="username" placeholder="Username (3-20 ký tự)" required minlength="3" maxlength="20">
      <input type="email" id="email" placeholder="Email" required>
      <input type="password" id="password" placeholder="Password (tối thiểu 6 ký tự)" required minlength="6">
      <button type="submit">Đăng ký</button>
    </form>
    <div id="message"></div>
    <p class="link">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
  </div>

  <script>
    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = document.getElementById('username').value;
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const messageDiv = document.getElementById('message');

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, email, password })
        });
        const data = await res.json();

        if (data.success) {
          messageDiv.className = 'message success';
          messageDiv.textContent = 'Đăng ký thành công! Đang chuyển sang đăng nhập...';
          setTimeout(() => window.location.href = '/login', 1500);
        } else {
          messageDiv.className = 'message error';
          messageDiv.textContent = data.error;
        }
      } catch (err) {
        messageDiv.className = 'message error';
        messageDiv.textContent = 'Lỗi kết nối: ' + err.message;
      }
    });
  </script>
</body>
</html>
