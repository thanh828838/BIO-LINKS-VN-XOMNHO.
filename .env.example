# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên git và KHÔNG đưa vào ZIP.

PORT=3000
NODE_ENV=development

# PostgreSQL — ví dụ: postgres://user:password@localhost:5432/xnbiolinks
DATABASE_URL=

# Chuỗi bí mật cho cookie session — dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
SESSION_SECRET=
